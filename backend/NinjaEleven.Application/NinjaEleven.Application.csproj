<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NinjaEleven.Domain\NinjaEleven.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The abstractions only, so a service can say what it did and did not do without
         taking a dependency on a logging implementation. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <!-- The world's tolerances are configured, not constant, so the options types are part
         of the contract the Application layer publishes. -->
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.4" />
    <!-- The scope a fixture is played in. It is the only place the Application layer
         composes a container, and it exists so a match is a unit of work of its own. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.4" />
    <!-- The loop that moves a match's clock is a hosted service of the Application layer, and
         every process that can open a match has to run it: the API and the Scheduler both do,
         against their own broadcaster. Only the lifecycle contract, no host and no implementation. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.4" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
