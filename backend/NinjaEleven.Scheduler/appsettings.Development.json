{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Quartz": "Information"
    }
  },

  "//": "A world being debugged is looked at every minute rather than twice a day. The calendar still decides which windows are due, so this only makes the process more attentive, not more eager.",

  "Scheduler": {
    "Enabled": true,
    "LeagueRoundCron": "0 * * * * *",
    "CupRoundCron": "0 * * * * *",
    "SuperCupRoundCron": "0 * * * * *",
    "RunDueOnStartup": true,
    "StartupDelaySeconds": 5,
    "MisfireThresholdSeconds": 300,
    "MigrateOnStartup": false
  },

  "World": {
    "RoundClaimLease": "00:05:00",
    "DueTolerance": "00:15:00",
    "SessionLease": "00:02:00",
    "MaxParallelFixtures": 8
  }
}
