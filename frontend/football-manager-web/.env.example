# Base URL of the Football Manager API.
# Default (used when this file is absent): http://localhost:5100
# Use /api to go through the Vite dev proxy instead of calling the API directly.
VITE_API_BASE_URL=http://localhost:5100

# Base URL of the SignalR hub. Defaults to VITE_API_BASE_URL when empty.
VITE_HUB_BASE_URL=
